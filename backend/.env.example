# Copy this file to ".env" in this (backend/) folder.
# The AI chatbot needs a FREE Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Database Configuration (postgresql or sqlite3)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=student_management
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432


